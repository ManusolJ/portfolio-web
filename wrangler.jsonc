{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio-web",
  "compatibility_date": "2026-09-05",
  "compatibility_flags": ["nodejs_compat"],

  "workers_dev": false,
  "routes": [{ "pattern": "manusoler.dev", "custom_domain": true }],
  "preview_urls": false,

  "observability": {
    "enabled": true,
  },

  "assets": {
    "directory": "dist/portfolio-web/browser/",
    "not_found_handling": "404-page",
  },
}
