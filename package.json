{
  "name": "portfolio-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "extract-i18n": "ng extract-i18n --output-path src/locale",
    "create-interface": "ng generate interface --path=src/app/shared/interfaces",
    "create-pipe": "ng generate pipe --skip-tests true --path=src/app/shared/pipes",
    "create-guard": "ng generate guard --skip-tests true --path=src/app/core/guards",
    "create-component": "ng generate component --skip-tests true --path=src/app/shared/components",
    "create-interceptor": "ng generate interceptor --skip-tests true --path=src/app/core/interceptors",
    "create-service": "ng generate service --skip-tests true --path=src/app/core/services",
    "create-feature": "ng generate component --skip-tests true --path=src/app/features"
  },
  "private": true,
  "packageManager": "npm@11.14.1",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/platform-server": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@angular/ssr": "^21.2.23",
    "@lucide/angular": "^1.43.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^21.4.0",
    "@angular/build": "^21.2.10",
    "@angular/cli": "^21.2.10",
    "@angular/compiler-cli": "^21.2.0",
    "@angular/localize": "^21.2.22",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20.17.19",
    "angular-eslint": "^21.4.0",
    "eslint": "^10.10.0",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.28",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.0.8",
    "wrangler": "^4.15.2"
  },
  "overrides": {
    "sharp": "^0.35.4"
  }
}
