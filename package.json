{
  "name": "portfolio-web",
  "version": "0.0.0",
  "scripts": {
    "start": "ng serve",
    "build": "ng build",
    "test": "ng test",
    "lint": "ng lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "extract-i18n": "ng extract-i18n --output-path src/locale",
    "create-interface": "ng generate interface --path=src/app/shared/models",
    "create-feature": "ng generate component --skip-tests true --path=src/app/features",
    "create-service": "ng generate service --skip-tests true --path=src/app/core/services",
    "create-component": "ng generate component --skip-tests true --path=src/app/shared/components"
  },
  "private": true,
  "packageManager": "npm@11.14.1",
  "dependencies": {
    "@angular/ssr": "^21.2.23",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/platform-server": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "@ng-icons/core": "^34.0.0",
    "@ng-icons/lucide": "^34.0.0",
    "@ng-icons/tabler-icons": "^34.0.0",
    "@ng-icons/devicon": "^34.0.0",
    "@fontsource-variable/open-sans": "^5.3.0"
  },
  "devDependencies": {
    "@angular/cli": "^21.2.10",
    "@angular/build": "^21.2.10",
    "@angular/localize": "^21.2.22",
    "@angular/compiler-cli": "^21.2.0",
    "@angular-eslint/builder": "^21.4.0",
    "@types/node": "^20.17.19",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.28",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8",
    "wrangler": "^4.15.2",
    "eslint": "^10.10.0",
    "@eslint/js": "^10.0.1",
    "angular-eslint": "^21.4.0",
    "typescript-eslint": "^8.69.0",
    "eslint-plugin-perfectionist": "^5.11.0"
  },
  "overrides": {
    "sharp": "^0.35.4"
  }
}
